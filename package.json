{
  "name": "nomade-raiz",
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test": "node --import ./scripts/register-test-loader.mjs ./scripts/run-tests.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "dexie": "^4.4.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "description": "Aplicativo offline-first para cicloviagem, autonomia, planejamento, equipamentos e vida na estrada.",
  "keywords": [
    "cicloviagem",
    "bikepacking",
    "cicloturismo",
    "offline-first",
    "checklist",
    "planejamento",
    "autonomia",
    "capacitor",
    "react"
  ],
  "homepage": "https://github.com/adriedsonlemoz/NomadeRaiz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adriedsonlemoz/NomadeRaiz.git"
  },
  "bugs": {
    "url": "https://github.com/adriedsonlemoz/NomadeRaiz/issues"
  },
  "engines": {
    "node": "20.x"
  }
}
